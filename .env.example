# Copy to .env and edit. `.env` is gitignored and holds REAL secrets - never commit or print it.
# Every key below is read by app/config.py. Keys marked [tunable] can also be overridden at
# runtime via Admin -> System Settings (DB wins over .env); the value here is only the bootstrap
# default. Secrets and filesystem paths are .env-only. See docs/core/06-system-settings.md.

# ---- Database (MariaDB / MySQL, pymysql driver) ------------------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=oqb2

# ---- Flask --------------------------------------------------------------------------------
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development
FLASK_DEBUG=1

# ---- Filesystem roots (keep SOURCE_PATH and STORAGE_PATH on the same drive) ---------------
# Question assets library (read-mostly). Layout: <SUBJ>/PP/<SOURCE>/<YEAR>/<PAPER>/ and <SUBJ>/QB/<DETAIL>/
SOURCE_PATH=D:/oqb_data/Source
# Parent of Shared/ System/ User/ (default: sibling "Storage" next to SOURCE_PATH)
STORAGE_PATH=D:/oqb_data/Storage
# Optional fine-grained overrides (default to subfolders of STORAGE_PATH)
#SHARED_PATH=
#SYSTEM_PATH=
#USER_PATH=
#DOC_THUMBNAIL_PATH=            # default <SYSTEM_PATH>/doc_thumbnails
# Server-side PDF library for PDF Batch Import / Toolbox pickers (default: SHARED_PATH)
#PDF_SOURCE_PATH=
# Legacy fallback for generated files created before the per-user relocation
#OUTPUT_PATH=./output

# ---- External binaries --------------------------------------------------------------------
# pandoc is required for Markdown -> docx during generation (default: `pandoc` on PATH)
#PANDOC_PATH=C:/Program Files/Pandoc/pandoc.exe
# Tesseract for PDF Tool Find & Mark OCR (blank = auto-detect common Windows paths / PATH)
#TESSERACT_CMD=

# ---- Dashboard / Markdown [tunable] -------------------------------------------------------
#QUESTIONS_PER_PAGE=20
#MD_MAX_SIZE_BYTES=5242880

# ---- Word COM (Windows + Microsoft Word) [tunable] ----------------------------------------
#WORD_COM_TIMEOUT=300            # intended per-job limit (s); registered but NOT enforced by app/word_com.py today
#WORD_COM_LOCK_TIMEOUT=600       # max wait (s) for the global Word lock

# ---- DOC thumbnails [tunable] -------------------------------------------------------------
#DOC_THUMBNAIL_WIDTH=1000
#THUMBNAIL_TRANSPARENT=0
#THUMBNAIL_WHITENESS_THRESHOLD=250
#THUMBNAIL_BOTTOM_PADDING_PX=24
#THUMBNAIL_SYMMETRIC_HORIZONTAL_CROP=0

# ---- Batch IMG generation (DOC/MD -> PNG) [tunable] ---------------------------------------
#BATCH_IMG_DEFAULT_WIDTH=1500
#BATCH_IMG_DEFAULT_STITCH=1

# ---- AI Tools -----------------------------------------------------------------------------
# Secrets (.env only)
# Global fallback API key used when an LLM endpoint has no key of its own
LLM_API_KEY=
# Fernet secret for encrypting UI-entered endpoint keys at rest. Blank = derive from SECRET_KEY.
# Rotating this (or SECRET_KEY when blank) invalidates stored endpoint keys - re-enter them.
LLM_KEY_SECRET=
# Tunables [tunable]
#AI_TOOLS_ENABLED=1
#LLM_IMAGE_MAX_DIM=1600
#LLM_CHAT_TIMEOUT_SECONDS=600
#LLM_REASONING_EFFORT_DEFAULT=off      # off | low | medium | high
#LLM_REASONING_SUMMARY_DEFAULT=auto    # auto | none
# Per-feature default LLM endpoint names (blank = first enabled vision-capable endpoint)
#EXPLAIN_DEFAULT_LLM=
#AUTOTAG_DEFAULT_LLM=
#MD_DEFAULT_LLM=
#CHECK_DEFAULT_LLM=
#SOLVEGEN_DEFAULT_LLM=
#SOLVECHECK_DEFAULT_LLM=
#PDF_IMPORT_DEFAULT_LLM=
#SMART_IMPORT_DEFAULT_LLM=

# ---- PDF Batch Import [tunable] -----------------------------------------------------------
#PDF_IMPORT_RASTER_WIDTH=1700
#PDF_IMPORT_RASTER_WORKERS=4
#PDF_IMPORT_COORD_ORDER=xyxy           # xyxy | yxyx
#PDF_IMPORT_DESKEW_DEFAULT=1
#PDF_IMPORT_DEFAULT_METHOD=llm         # llm | refine | segment
#PDF_IMPORT_CROP_PAD_PCT=0.6
#PDF_IMPORT_REFINE_GROW_PCT=3.5
#PDF_IMPORT_ASSIST_PAD_PCT=0.6
#PDF_IMPORT_TRIM_WHITE_DEFAULT=0
#PDF_IMPORT_UNIFORM_WIDTH_DEFAULT=0  # legacy; prefer Snap to page frame
#PDF_IMPORT_FRAME_SNAP_DEFAULT=1
#PDF_IMPORT_FRAME_INSET_PCT=0.5
#PDF_IMPORT_FRAME_NORMALISE_WIDTH=1
# PDF import AI agent [tunable]: outline batch size, thumbnail px, verify/repair rounds, call budget
#PDF_AGENT_OUTLINE_BATCH_PAGES=6
#PDF_AGENT_THUMB_MAX_DIM=900
#PDF_AGENT_MAX_REPAIR_ROUNDS=2
#PDF_AGENT_MAX_LLM_CALLS=150

# ---- Toolbox PDF Tool ---------------------------------------------------------------------
#TOOLBOX_DEFAULT_DPI=200               # [tunable]
#TOOLBOX_OCR_DPI=300                   # [tunable]
#TOOLBOX_OCR_WORKERS=4                 # [tunable]
#TOOLBOX_OCR_AUTO_ORIENT=1             # [tunable]
#TOOLBOX_SESSION_RETENTION_HOURS=48    # [tunable] (registry default; no Config attribute)
#TOOLBOX_RASTER_WIDTH=1700             # .env only
#TOOLBOX_EXPORT_WIDTH=2200             # .env only (fallback for pages staged before per-page DPI)
#TOOLBOX_SAVE_SUBDIR=Saved             # .env only

# ---- Markup PWA [tunable] -----------------------------------------------------------------
#MARKUP_NORMALIZED_MAX_DIM=2400
